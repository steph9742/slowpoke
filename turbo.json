{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".nuxt/**",
                ".output/**",
                "dist/**"
            ]
        },
        "lint": {},
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ],
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    },
    "ui": "tui",
    "globalEnv": ["DATABASE_URL", "OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET", "OIDC_DISCOVERY_URL", "READONLY_DATABASE_URL"]
}