# Slowpoke — variables d'environnement. Copier en `.env` et renseigner.
# `.env` est ignoré par Git : il ne doit JAMAIS être committé.

# --- Base de données ---------------------------------------------------------------------
POSTGRES_USER=slowpoke
POSTGRES_PASSWORD=
POSTGRES_DB=slowpoke
DATABASE_URL=postgresql://slowpoke:<mot-de-passe>@postgres:5432/slowpoke

# Rôle PostgreSQL en LECTURE SEULE, pour le query builder et les widgets de statistiques.
# La migration 0004 crée le rôle `query_builder` SANS mot de passe : il faut lui en poser un
# (voir doc/Installation-Reglages.md § B.2), sinon ces deux fonctions ne marchent pas.
READONLY_DATABASE_URL=postgresql://query_builder:<mot-de-passe>@postgres:5432/slowpoke

# --- Adresses publiques ------------------------------------------------------------------
PORT=4000
NUXT_PUBLIC_SERVER_BASE_URL=https://<votre-domaine>
SITE_URL=https://<votre-domaine>
BETTER_AUTH_URL=https://<votre-domaine>
TRUSTED_ORIGINS=https://<votre-domaine>
# Origine employée pour citer un incident par son adresse. À défaut, la première valeur de
# TRUSTED_ORIGINS. Une adresse reconstituée depuis l'en-tête `Host` serait fausse derrière un proxy.
PUBLIC_APP_URL=https://<votre-domaine>

# Port publié par le reverse proxy interne. « 8080 » ou « 127.0.0.1:8080 » pour n'écouter
# que sur la boucle locale, derrière une terminaison TLS.
REVERSE_PUBLISH=8080

# --- SSO OpenID Connect ------------------------------------------------------------------
# Sans ces trois variables, le fournisseur n'est pas déclaré et seule la connexion de secours
# par mot de passe reste ouverte.
# L'ancien nommage `OUATE_*` est encore lu en secours (compatibilité ascendante) : une
# installation en service monte de version sans toucher à son `.env`.
# Secret de signature des sessions Better Auth. Obligatoire : sans lui, la création de compte
# peut être refusée. Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://<idp>/.well-known/openid-configuration
# Libellé du bouton de connexion (défaut : « Connexion SSO »).
OIDC_PROVIDER_LABEL=
# Groupe dont les membres sont créés administrateurs, lu dans la claim `groups`.
OIDC_ADMIN_GROUP=admins
# Scopes demandés (défaut : openid profile email groups).
OIDC_SCOPES=
# Modèle d'URL d'avatar, `{id}` étant l'identifiant du compte. Vide : aucun avatar.
OIDC_AVATAR_URL_TEMPLATE=
# Restreint la connexion par mot de passe à un domaine de messagerie (optionnel).
AUTH_DOMAIN=

# `false` ferme la connexion par mot de passe. Ignoré si le SSO n'est pas configuré : une
# option de durcissement ne doit pas pouvoir fermer la dernière porte.
AUTH_SECOURS=true

# Compte administrateur de secours, créé par `docker compose run --rm server /app/seed`.
# Le FICHIER est préférable à la variable : une variable se lit dans `docker inspect`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD_FILE=/app/.secrets/admin-password
# À défaut du fichier seulement, et jamais en production : une variable se lit dans les
# journaux de l'orchestrateur.
# SEED_ADMIN_PASSWORD=

# --- Notifications Web Push --------------------------------------------------------------
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<adresse-de-contact>

# --- Chiffrement des jetons d'intégration ------------------------------------------------
# Laisser vide : la clé est engendrée au premier besoin dans `.secrets/`, hors de la base.
# ⚠️ `.secrets/` doit être sauvegardé avec la base, sinon les jetons deviennent illisibles.
SETTINGS_ENCRYPTION_KEY=
# Emplacement du fichier de clé (défaut : /app/.secrets/settings.key).
SETTINGS_KEY_FILE=

# --- Garde-fous du query builder ---------------------------------------------------------
QUERY_BUILDER_MAX_ROWS=5000
QUERY_BUILDER_TIMEOUT_MS=10000

# --- Version affichée par /health (passées au `docker compose build`) --------------------
# GIT_COMMIT=$(git rev-parse --short HEAD)
# BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
